{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "lead",
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git branch -D*": "ask",
      "git clean -f*": "ask",
      "git push --force*": "ask",
      "rm -rf*": "ask",
      "npm publish*": "ask"
    },
    "webfetch": "allow",
    "websearch": "allow"
  }
}